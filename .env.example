# Optional: override the settings file location. Defaults to ./.env. The
# server also writes .env.tmp next to it while saving, so keep the parent
# directory writable.
# SETTINGS_ENV_PATH=

# Required for YouTube search (Research page).
# Google Cloud Console: enable "YouTube Data API v3", create an API key.
YOUTUBE_API_KEY=

# Required for AI Insights, grounded Ideas, Script Writer, and Thumbnail Creator.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave blank to use the built-in default (gemini-3.6-flash).
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional: YouTube API timeouts in milliseconds. Leave blank for the
# defaults (30s per request, 60s for a full research run).
# YOUTUBE_TIMEOUT_MS=
# YOUTUBE_TOTAL_TIMEOUT_MS=

# Optional: custom provider settings (separate for text and image).
# When CUSTOM_TEXT_PROVIDER is not gemini, CUSTOM_TEXT_BASE_URL, API_KEY, and MODEL are required.
# CUSTOM_IMAGE_PROVIDER accepts "gemini", "openai-compatible", or "pollinations".
CUSTOM_TEXT_PROVIDER=
CUSTOM_TEXT_BASE_URL=
CUSTOM_TEXT_API_KEY=
CUSTOM_TEXT_MODEL=
CUSTOM_IMAGE_PROVIDER=
CUSTOM_IMAGE_BASE_URL=
CUSTOM_IMAGE_API_KEY=
CUSTOM_IMAGE_MODEL=

# Optional: HTTP port, defaults to 5433.
PORT=5433

# Optional: bind address, defaults to loopback. Do not set 0.0.0.0 without a
# trusted authentication and rate-limiting gateway. Local Settings is not a
# public secret-management endpoint.
HOST=127.0.0.1

# Optional: outbound HTTP/HTTPS proxy. Useful when the host machine is behind a
# restrictive ISP that filters Google API endpoints. The server routes all
# YouTube API and Gemini requests through this proxy when set. Supports
# http:// and https:// URIs. Both uppercase and lowercase variants are accepted.
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
# Lowercase variants (https_proxy, http_proxy, all_proxy) and ALL_PROXY are
# also accepted at boot; HTTPS_PROXY takes precedence.
